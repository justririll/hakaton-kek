# Скопируйте в .env и подставьте свой ключ: cp .env.example .env
# Ключ выдаётся в Google AI Studio; без него платформа работает без AI-резюме.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Если Google блокирует IP сервера («User location is not supported»),
# укажите прокси только для вызовов Gemini, например http://172.17.0.1:40001
GEMINI_PROXY=
